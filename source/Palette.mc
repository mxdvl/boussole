import Toybox.Graphics;

//! Named colours shared across rings.
module Palette {

    //! The main time arc and its hour bar.
    const CHALK = Graphics.COLOR_WHITE;

    //! Brume ("mist"): a soft teal-blue grey for everything secondary - hour
